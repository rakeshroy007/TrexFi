generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
}


model User {
  id              String    @id @default(uuid())
  clerkUserId     String    @unique     // clerk user id
  email           String    @unique
  name            String?
  imageUrl        String? 
  transactions    Transaction[] 
  accounts        Account[]
  budgets         Budget[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("users")
}


model Account{
  id                  String          @id @default(uuid())
  name                String
  type                AccountType            // It is called enum, An enum (enumeration) is a predefined set of limited values...
  balance             Decimal         @default(0)
  isDefault           Boolean         @default(false)
  userId              String
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)   // why did we use 'user' here --> 🖼️🖼️🖼️ Pic Available --> "/Education Pic/Nextjs"
  transactions        Transaction[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([userId])
  @@map("accounts")
}

enum AccountType {
  CURRENT
  SAVINGS
}


model Transaction{ 
  id                      String                @id @default(uuid())
  type                    TransactionType
  amount                  Decimal
  description             String?
  date                    DateTime
  category                String
  receiptUrl              String?
  isRecurring             Boolean               @default(false)
  recurringInterval       RecurringInterval?        // Only used if isRecurring is true
  nextRecurringDate       DateTime?                 // Next date for recurring transaction
  lastProcessed           DateTime?                 // Last time this recurring transation was processed
  status                  TransactionStatus     @default(COMPLETED)
  userId                  String
  user                    User                  @relation(fields: [userId], references: [id], onDelete:Cascade)
  accountId               String
  account                 Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@index([userId])
  @@index([accountId])
  @@map("transaction")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum RecurringInterval {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}


model Budget{
  id                  String            @id @default(uuid())
  amount              Decimal
  lastAlertSent       DateTime?           // Track when the last alert was sent... 
  userId              String            @unique    // This tells us "One user can have only one budget"
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([userId])
  @@map("budgets")
} 

